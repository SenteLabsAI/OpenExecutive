# Required UNLESS you run entirely on local or OpenRouter models (see
# LOCAL_MODELS_ENABLED / OPENROUTER_ENABLED below). At least one provider must
# be configured or the app refuses to start.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only for a key issued at the ORGANISATION level rather than inside a
# workspace. Those keys are rejected with HTTP 400 unless every request carries
# the workspace id. Leave unset for a workspace-scoped key.
# ANTHROPIC_WORKSPACE_ID=

# --- Auth (UI: Auth.js / NextAuth v5 with Google) -----------------------------
# Trying it alone? Leave AUTH_GOOGLE_ID blank: `make dev` then uses local
#   login — no sign-in, reachable only from this computer, and you
#   are the owner (docs/auth.md). Fill in this block to invite your team or to
#   run it on a server; `make docker` always needs it.
# Generate AUTH_SECRET with: openssl rand -base64 32
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET come from a Google Cloud OAuth Client
#   (Web application). Authorized redirect URIs must include:
#     - http://localhost:3000/api/auth/callback/google
#     - https://<your-ui-host>/api/auth/callback/google
# ALLOWED_EMAILS = comma-separated list of Google-account emails permitted to
#   sign in. Always honored, and always sufficient on its own. People in the
#   backend roster (non-archived Person rows with an email) are allowed IN
#   ADDITION to this list, never instead of it — so roster changes cannot
#   lock out an operator listed here. Any other email is rejected, even with
#   a valid Google login.
# AUTH_TRUST_HOST = "true" is required when running behind a reverse proxy.
# AUTH_URL = public origin of the UI. LEAVE BLANK for local dev (localhost is
#   inferred). Required on any public deployment; AUTH_TRUST_HOST alone
#   isn't enough — without AUTH_URL the post-callback redirect lands on the
#   container's bind address (0.0.0.0) instead of the public hostname,
#   e.g. AUTH_URL=https://exec.example.com
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=alice@example.com,bob@example.com
AUTH_TRUST_HOST=true
AUTH_URL=

# Shared secret between the Next.js proxy and the FastAPI backend. The UI
# attaches this as `x-api-key`; the API requires it on every non-exempt
# request. Leave unset for `make dev` (gate off); set it to the same random
# value on both apps in any deployed environment. Generate with:
#   openssl rand -hex 32
BACKEND_SHARED_SECRET=

# Comma-separated extra CORS origins for the FastAPI backend; localhost is
# always allowed. Deployment-only — LEAVE BLANK for local dev: with the
# shared-secret gate unset, listing a public origin here lets scripts on
# that origin read your local API with credentials.
# On deploy: BACKEND_ALLOWED_ORIGINS=https://exec.example.com
BACKEND_ALLOWED_ORIGINS=

# Declares this instance as internet-reachable. Set to 1 on every public
# deployment: the API then REFUSES TO START without BACKEND_SHARED_SECRET,
# instead of serving an unauthenticated API with only a log warning. Leave
# blank for local dev. Any value other than 0/false/no/off arms the check.
OE_PUBLIC_DEPLOYMENT=

# Model configuration (defaults shown)
DEFAULT_MODEL=claude-sonnet-5
DEEP_REASONING_MODEL=claude-opus-5
ROUTING_MODEL=claude-haiku-4-5

# Data paths (defaults shown — relative to repo root, override with absolute paths if needed)
# VECTOR_STORE_PATH=./chroma_db
# COMPANY_PROFILE_PATH=./company/profile.yaml
# EPISODIC_DB_PATH=./episodic_memory.db    # SQLite for episodic memory, alerts, knowledge review

# Feature flags
ENABLE_CACHING=true

# --- OpenRouter routing -------------------------------------------------------
# Toggle that routes Claude calls through OpenRouter (so usage is billed to
# your OpenRouter account) AND unlocks the curated set of non-Anthropic
# models (GPT-5, Gemini 2.5 Pro, Llama, DeepSeek, Grok) in the Council UI
# dropdown so any agent can be flipped to a non-Anthropic model per-agent.
# Off by default — a fresh checkout's behavior is identical to before.
OPENROUTER_ENABLED=false
# Required when OPENROUTER_ENABLED=true. Get one at https://openrouter.ai.
OPENROUTER_API_KEY=
# Live model catalog. With OpenRouter enabled the API fetches OpenRouter's
# public /models list at startup (and every OPENROUTER_CATALOG_REFRESH_S) to
# fill the non-Anthropic entries of the Council dropdown, so new releases
# show up without a code change. Filtered to tool-capable, paid, text-only
# models from the vendors below — newest N per vendor. A failed fetch keeps
# the built-in fallback list. Defaults shown.
# OPENROUTER_CATALOG_ENABLED=true
# OPENROUTER_CATALOG_PROVIDERS=openai,google,anthropic,meta-llama,deepseek,x-ai
# OPENROUTER_CATALOG_PER_PROVIDER=6
# OPENROUTER_CATALOG_TIMEOUT_S=10
# OPENROUTER_CATALOG_REFRESH_S=21600

# --- Local / self-hosted models ----------------------------------------------
# Route selected model slugs to a local OpenAI-compatible server (Ollama,
# LM Studio, vLLM, llama.cpp, …) instead of the Anthropic API. Off by default;
# a fresh checkout behaves identically to before.
# Also works with HOSTED OpenAI-compatible gateways: point LOCAL_BASE_URL at
# the gateway's /v1 endpoint, set LOCAL_API_KEY, and list its model slugs in
# LOCAL_MODELS. See README → "Using a hosted OpenAI-compatible gateway".
LOCAL_MODELS_ENABLED=false
# Base URL of the local server, INCLUDING the version path. Required when
# LOCAL_MODELS_ENABLED=true.
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   vLLM       http://localhost:8000/v1
LOCAL_BASE_URL=
# Optional bearer token. Ollama / LM Studio need none (leave blank); vLLM or a
# gateway in front may require one.
LOCAL_API_KEY=
# Comma-separated model slugs to surface in the Council UI and route locally.
# Sent to the server verbatim, so they must match what it serves
# (e.g. `ollama list`). Example: llama3.3,qwen2.5:14b
LOCAL_MODELS=
# Local generation (especially on CPU) can be slow — generous timeout (seconds).
LOCAL_TIMEOUT_S=300
# Off by default. The `usage: {include: true}` request field is an
# OpenRouter-only cost-accounting extension, not part of the OpenAI or
# Anthropic request schema — a plain self-hosted server (Ollama, vLLM) or a
# strict gateway that forwards nearly verbatim to real Anthropic rejects an
# unrecognized top-level field outright instead of ignoring it (every local
# call returns 400). Only enable this if you've confirmed your LOCAL_BASE_URL
# backend actually speaks OpenRouter's request format — some hosted, billed
# gateways do, and then this restores real USD cost tracking on the
# /audit cache_event rows for those calls.
LOCAL_INCLUDE_USAGE_ACCOUNTING=false
#
# To run with NO Anthropic key, configure the three lines above AND point the
# model settings at local slugs:
#   DEFAULT_MODEL=llama3.3
#   DEEP_REASONING_MODEL=llama3.3
#   ROUTING_MODEL=llama3.3
# (Server-side web search has no local equivalent and is disabled for local
# models; tool-use quality depends on the model you choose.)

# --- Chat turn timeouts -------------------------------------------------------
# Whole-turn wall-clock ceiling for a streaming /chat turn, in seconds. A turn
# that exceeds it is cut off and whatever streamed so far is persisted. Users
# can also end a turn themselves with the Stop button (POST /chat/stop), which
# is what makes a ceiling this generous reasonable.
# CHAT_STREAM_TIMEOUT_S=300
# Extra allowance added on top when a message opts in to Committee review, so
# 360s in total at the defaults.
# COMMITTEE_EXTRA_TIMEOUT_S=60
# Per-call ceiling for the onboarding interview. Kept separate from the chat
# ceiling: the wizard retries twice, so a 300s value here would mean a 10-minute
# hang before the user sees a timeout.
# INTERVIEW_TIMEOUT_S=120

# --- Honcho per-person memory ------------------------------------------------
# External memory layer (https://honcho.dev) that gives the Executive a
# per-person peer card shared across Slack, Discord, Telegram, email, and the
# web UI. When enabled, each turn does one prefetch + fire-and-forget
# sync_turn keyed off the inbound user's Person.id; turns with no matching
# Person row pass through with no Honcho call. Works against hosted Honcho
# (leave HONCHO_BASE_URL empty) or a self-hosted instance (set it). Off by
# default — a fresh checkout behaves identically to before.
HONCHO_ENABLED=false
# Required when HONCHO_ENABLED=true.
HONCHO_API_KEY=
# Self-hosted Honcho endpoint, e.g. http://honcho.internal:8000
HONCHO_BASE_URL=
# Workspace id scopes peer cards within a Honcho deployment. Keep stable
# across environments unless you intentionally want isolated memory.
HONCHO_WORKSPACE_ID=openexec
# Hard timeout on the per-turn prefetch. On timeout the turn proceeds with
# whatever the builtin episodic block provides (no peer_memory injected).
HONCHO_PREFETCH_TIMEOUT_S=3.0
# How the per-turn prefetch reads the person's memory. `representation`
# (default) reads the peer card and the derived conclusions most relevant to
# the inbound message: a GET with no LLM behind it, ~100 ms. `dialectic` asks
# Honcho a reasoned question instead (an LLM call, seconds; `reasoning_level`
# applies). Set `dialectic` for a Honcho server without the peer-context route.
HONCHO_PREFETCH_MODE=representation
# Conclusions retrieved per turn in representation mode (1-100).
HONCHO_PREFETCH_MAX_CONCLUSIONS=20
# Override if you're proxying OpenRouter or running an Azure-style gateway.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_TITLE="Open Executive"
# OPENROUTER_REFERER=https://your-deployment.example.com
# OPENROUTER_TIMEOUT_S=180.0

# Web search — Anthropic's native server-side web_search tool. The application
# default is ON (unset means enabled); this file ships it off so a fresh setup
# incurs no per-search charges until you opt in. Set true to let the Executive
# and specialists combine your uploaded documents with live lookups (market
# data, news, regulatory changes, competitor moves).
ENABLE_WEB_SEARCH=false
WEB_SEARCH_MAX_USES=5
# Optional allowlist OR blocklist (comma-separated bare domains, no scheme).
# Set at most one of the two.
# WEB_SEARCH_ALLOWED_DOMAINS=
# WEB_SEARCH_BLOCKED_DOMAINS=

# Slack integration (optional). Setting BOTH tokens starts the Socket Mode
# listener as part of the API's own startup — `make dev` brings Slack up with
# the rest of the app, no separate process. Leave either unset to disable
# inbound Slack (outbound sends only need SLACK_BOT_TOKEN).
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Exec email address — REQUIRED. Must match the Google account authenticated with
# Gmail MCP OAuth. No default: the Executive must never operate from a fallback
# address because EXEC_EMAIL_ADDRESS silently fell through.
EXEC_EMAIL_ADDRESS=exec@example.com
# How often the email poller checks for new messages (seconds, default 60)
EMAIL_POLL_INTERVAL_SECONDS=60
# Channel access (Email/Telegram/Discord) is roster-driven: only senders
# whose channel ID matches a non-archived Person row receive a response.
# Manage access via the /people UI; no env-var allowlists.

# Telegram integration (optional)
# Setup: docs/telegram_setup.md
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Must equal the secret_token passed to setWebhook, or every update is rejected
# with 401. 1-256 chars of A-Z a-z 0-9 _ - (e.g. `openssl rand -hex 32`).
TELEGRAM_WEBHOOK_SECRET=

# Discord integration (optional)
# Setup: create an application at https://discord.com/developers/applications
# Enable the "Message Content" privileged intent. Invite with bot + applications.commands scopes.
# Setting DISCORD_BOT_TOKEN starts the bot inside the API — `make dev` brings it
# up, no separate process. Don't also run `make discord` while the API has the
# token: two gateway connections on one token answer every message twice.
# Bot token from the Discord Developer Portal → Bot tab
DISCORD_BOT_TOKEN=
# Application ID (General Information tab)
DISCORD_APP_ID=
# comma-separated guild (server) IDs for instant slash-command registration during dev; leave blank for global
DISCORD_GUILD_IDS=
# default channel ID for outbound notifications/alerts (optional)
DISCORD_NOTIFY_CHANNEL_ID=
DISCORD_THREAD_RESPONSE_GATE_ENABLED=true  # in bot-owned threads, ask Haiku whether each non-mention message warrants a reply (filters side chatter in multi-party threads); set to false to reply to every thread message

# Google Chat integration (optional)
# Numeric project number (not the project ID) — see docs/google_chat_setup.md
GOOGLE_CHAT_PROJECT_NUMBER=
# Auth — set ONE of the following (see docs/google_chat_setup.md for which to use):
# Option A: absolute path to SA JSON key (blocked by some org policies)
GOOGLE_CHAT_SERVICE_ACCOUNT_FILE=
# Option B: SA email for impersonation via ADC (gcloud auth application-default login)
GOOGLE_CHAT_SERVICE_ACCOUNT_EMAIL=

# Google Workspace MCP (optional — enables Gmail, Calendar, Drive access)
# Outbound email is sent via Gmail MCP using the account authenticated below.
# Setup: https://github.com/taylorwilsdon/google_workspace_mcp
# 1. Create OAuth Desktop credentials at console.cloud.google.com
#    Enable: Gmail API, Google Calendar API, Google Drive API
# 2. Set these two vars, then mint a token (workspace-mcp has no `auth`
#    subcommand — OAuth fires on the first tool call):
#      uv run --with mcp python scripts/mint-google-token.py
#    Sign in as EXEC_EMAIL_ADDRESS. Credentials land in
#    .gworkspace-credentials/ (gitignored).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# MCP gateway (the client side — external MCP servers surfaced as Executive
# tools, including the Google Workspace one configured above).
# NOTE: this is the gateway only. Exposing Open Executive itself AS an MCP
# server to other agents is a separate feature that needs none of these vars:
# it is served at /mcp by the API and gated by BACKEND_SHARED_SECRET above.
# See the "Connect as an MCP Server" section of README.md.
# Left unset, MCP turns itself on when MCP_SERVERS_CONFIG_PATH exists, so
# copying mcp_servers.json.example into place is all that is needed. Set it
# explicitly to override that either way: MCP_ENABLED=false keeps MCP off with
# the file still in place, MCP_ENABLED=true is a no-op unless the file defines
# at least one server under "mcpServers".
# A config that defines no servers, a path that is not a readable file, or a
# gateway that fails to start (or hangs) is not fatal — the API boots without
# MCP tools (and without the email poller) and logs the reason at ERROR.
# MCP_ENABLED=false
# MCP_SERVERS_CONFIG_PATH defaults to ./company/mcp_servers.json, relative to
# the working directory. Docker keeps it on the /data volume instead and sets
# the var explicitly — see docs/deployment.md.
# Folders a workflow action step's oe__read_file tool may read — where tools
# that download files (e.g. Gmail attachments via workspace-mcp) save them.
# Comma-separated. Default: $WORKSPACE_ATTACHMENT_DIR, else
# ~/.workspace-mcp/attachments (workspace-mcp's own default).
# WORKFLOW_FILE_DIRS=

# Outbound DM anti-spam guard (optional tuning)
# Applied at the send-tool chokepoint: a proactive Slack/Telegram/Discord DM is
# suppressed (and audited) when it would exceed the per-recipient rate cap,
# duplicate a recently-sent message, or land while the recipient is on leave /
# outside their availability windows. Defaults shown.
OUTBOUND_MAX_PER_RECIPIENT_PER_WINDOW=5   # max DMs to one recipient per rate window
OUTBOUND_RATE_WINDOW_MINUTES=60           # rolling window for the rate cap
OUTBOUND_DEDUP_WINDOW_MINUTES=360         # suppress a near-identical resend within this window
OUTBOUND_RESPECT_QUIET_HOURS=true         # honor recipient availability windows / on-leave; set false to disable

# Overnight client rotation (multi-client practice mode). OFF by default:
# rotating activates each parked client at the configured time (UTC) to
# generate its brief + run monitors — conscious opt-in (LLM cost per client
# per night + automated context switching).
# CLIENT_ROTATION_ENABLED=true
# CLIENT_ROTATION_TIME=03:30

# Notion → isolated wiki-collection sync (optional). OFF by default. Create
# an internal integration at https://www.notion.so/my-integrations, share
# the company wiki (and only that) with it, then:
#   NOTION_SYNC_ENABLED=true
#   NOTION_API_KEY=ntn_...
# Pages land in the notion_wiki collection (not company_docs) and are
# labelled unreviewed at retrieval. Un-shared pages are purged on the
# next tick. Manual: openexecutive sync-notion / purge-notion
# NOTION_SYNC_ENABLED=false
# NOTION_API_KEY=
# NOTION_SYNC_INTERVAL_MINUTES=60
# NOTION_MAX_PAGES_PER_SCAN=40

# Alert lifecycle — keeps the briefing's "Needs you" queue and the daily
# briefs from going stale (alerts/lifecycle.py, alerts/review.py). Defaults
# shown; all optional. An unread alert older than its category TTL is
# expired by a scheduler sweep (reversible: POST /alerts/{id}/reopen).
# Monitoring = unrouted low/medium watchlist signals; action = everything a
# human should look at. 0 disables expiry for that category.
ALERT_TTL_DAYS_MONITORING=3
ALERT_TTL_DAYS_ACTION=14
# Executive alert review: every ALERT_REVIEW_INTERVAL_HOURS (and right
# before the morning brief) the Executive re-examines open alerts with
# evidence and, within department authority, routes + DMs the owner,
# nudges, escalates to the principal, drafts an artifact, folds
# duplicates, or resolves with evidence (only on high confidence). Every
# move is audited and reversible. ALERT_REVIEW_MAX_MOVES_PER_SCAN=0 keeps
# the review but makes it annotate-only (no DMs / drafts).
ALERT_REVIEW_ENABLED=true
ALERT_REVIEW_INTERVAL_HOURS=6
ALERT_REVIEW_MIN_AGE_HOURS=2
ALERT_REVIEW_MAX_PER_SCAN=25
ALERT_REVIEW_MAX_MOVES_PER_SCAN=10
# Daily briefs: when nothing changed since the last delivered brief, send a
# one-line "nothing new" instead of re-synthesising the same list.
PRINCIPAL_BRIEF_SUPPRESS_UNCHANGED=true
# Stop re-chasing the same stalled item forever (delivered nudges per item;
# 0 disables the cap).
NUDGE_MAX_PER_SCOPE=3

# Attunement — per-person open loops. Commitments ("I'll send it Thursday") and
# asks from anyone on the roster become open loops that the nudge engine
# chases once due; "sent it" from the same person closes them.
# ATTUNEMENT_ENABLED=true
# ATTUNEMENT_OPEN_LOOPS_ENABLED=true
# ATTUNEMENT_LOOP_DEFAULT_DUE_DAYS=2
# ATTUNEMENT_LOOP_TTL_DAYS=21
# ATTUNEMENT_MAX_OPEN_LOOPS_PER_PERSON=15
# ATTUNEMENT_MAX_CALLS_PER_DAY=200
# Outcome ledger: proactive DMs are resolved replied / acted, or ignored after
# ATTUNEMENT_IGNORE_AFTER_HOURS. A person whose last MUTE_MIN_SENDS resolved
# sends from a nudge source all went unanswered is chased less for it.
# ATTUNEMENT_IGNORE_AFTER_HOURS=72
# ATTUNEMENT_MUTE_MIN_SENDS=5
# ATTUNEMENT_MUTE_COOLDOWN_MULTIPLIER=3
# Working style: up to 4 short "how they like replies" rules per person, learned
# from their own thumbs up/down and requests. Re-learned after TRIGGER_TURNS new
# messages (or right after a thumbs-down), at most once per MIN_INTERVAL_HOURS
# and MAX_PER_DAY times a day per person.
# ATTUNEMENT_STYLE_ENABLED=true
# ATTUNEMENT_STYLE_TRIGGER_TURNS=10
# ATTUNEMENT_STYLE_MIN_INTERVAL_HOURS=2
# ATTUNEMENT_STYLE_MAX_PER_DAY=4
# Research council cadence: the periodic run is considered every
# WATCHLIST_RESEARCH_INTERVAL_MINUTES and skipped when nothing changed.
WATCHLIST_RESEARCH_INTERVAL_MINUTES=360
# Force a research-council re-run at most this often when internal state is
# unchanged (was daily; a daily forced run re-filed the same findings).
WATCHLIST_RESEARCH_MAX_STALENESS_HOURS=168
# Web searches each research specialist may run per run (separate from
# WEB_SEARCH_MAX_USES, which chat and standing queries use).
RESEARCH_WEB_SEARCH_MAX_USES=3
# Specialists the research run fans out to (comma-separated slugs from
# cso, cfo, cmo, coo, chro, cpo, gc). Empty = all seven.
# RESEARCH_SPECIALISTS=cso,cfo,coo
# Research watchlist policy: the research pass only proposes watches. A
# proposal grounded in company data (a named competitor / vendor / ticker /
# initiative) and corroborated is added on its own, quietly (at most
# MAX_DIRECT_ADDS per run); anything the Executive is not sure about lands
# as a dry-run SUGGESTION on /watchlist for you to approve or decline (at
# most MAX_PROPOSALS per run). Above WATCHLIST_MAX_ENABLED enabled watches
# every add becomes a suggestion; suggestions nobody reviews within
# WATCHLIST_PROPOSAL_TTL_DAYS are removed (re-proposable after 90 days).
WATCHLIST_RESEARCH_MAX_DIRECT_ADDS=2
WATCHLIST_RESEARCH_MAX_PROPOSALS=2
WATCHLIST_MAX_ENABLED=40
WATCHLIST_PROPOSAL_TTL_DAYS=14

# RAG relevance gates (cosine distance — LOWER is stricter; range 0-2).
# A hit further than the gate is dropped before the top-K slice.
#
# KNOWLEDGE_DISTANCE_THRESHOLD is the shared gate: COMPANY docs, the synced
# Notion wiki, and recent research. Raise it if company documents that
# obviously answer the question are not being surfaced — a question phrased
# conversationally embeds further from document prose than the same question
# phrased as keywords, so the right doc can rank first and still miss the gate.
#
# KNOWLEDGE_BUILTIN_DISTANCE_THRESHOLD optionally tightens the built-in
# knowledge base and the shipped failure cases only. Both are generic material
# and much larger than a typical company corpus, so a gate loose enough for
# your documents admits a lot of unrelated handbook prose with it. It can only
# tighten: a value looser than the shared gate is clamped to it. Unset, every
# collection shares the value above.
KNOWLEDGE_DISTANCE_THRESHOLD=0.55
# KNOWLEDGE_BUILTIN_DISTANCE_THRESHOLD=0.50
