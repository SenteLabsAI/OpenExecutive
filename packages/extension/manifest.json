{
  "manifest_version": 3,
  "name": "Open Executive",
  "short_name": "Open Executive",
  "version": "0.3.8",
  "description": "Lets your Open Executive get things done on websites for you: open pages, click, type and fill in forms.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Executive",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "tabs",
    "tabGroups",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "site-rules.js",
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
