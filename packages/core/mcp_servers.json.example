{
  "_comment": "google_workspace runs workspace-mcp co-located as a stdio child via docker/workspace-mcp-launch.sh, which selects the auth mode from GWORKSPACE_AUTH_MODE (oauth | service_account). The $VAR values in its env block are interpolated by extensible-mcp from the API's environment, so the API must have those secrets set and orchestrator/mcp_gateway.py forwards them (_FORWARDED_ENV_VARS). For local dev without the launcher script, use {\"command\":\"uvx\",\"args\":[\"workspace-mcp\",\"--tool-tier\",\"complete\",\"--single-user\"],\"env\":{...}} instead. See docs/deployment.md → 'Google Workspace (co-located in the API)'.",
  "mcpServers": {
    "gitlab": {
      "command": "/usr/local/bin/mcp-remote",
      "args": [
        "https://gitlab.com/api/v4/mcp",
        "--static-oauth-client-metadata",
        "{\"scope\":\"mcp\"}",
        "--transport",
        "http-only"
      ],
      "env": {
        "HOME": "/data",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "MCP_REMOTE_CONFIG_DIR": "/data/mcp-auth/gitlab"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@github/github-mcp-server", "stdio"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "google_workspace": {
      "command": "/usr/local/bin/workspace-mcp-launch.sh",
      "args": [],
      "env": {
        "GWORKSPACE_AUTH_MODE": "$GWORKSPACE_AUTH_MODE",
        "WORKSPACE_MCP_TOOL_TIER": "$WORKSPACE_MCP_TOOL_TIER",
        "WORKSPACE_MCP_CREDENTIALS_DIR": "$WORKSPACE_MCP_CREDENTIALS_DIR",
        "GOOGLE_OAUTH_CLIENT_ID": "$GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET": "$GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_SERVICE_ACCOUNT_KEY_JSON": "$GOOGLE_SERVICE_ACCOUNT_KEY_JSON",
        "USER_GOOGLE_EMAIL": "$USER_GOOGLE_EMAIL"
      }
    }
  },
  "filters": {
    "access_control": {
      "deny_patterns": [
        "*__delete_*", "*__drop_*", "*__destroy_*", "*__remove_*",
        "*delete_email*", "*delete_message*", "*trash*",
        "*delete_file*", "*delete_document*"
      ],
      "deny": [],
      "allow_servers": []
    },
    "load_control": {
      "deny_url_patterns": ["http://*"],
      "allow_url_patterns": []
    },
    "similarity_threshold": 0.3
  }
}
