# Faza 1 — judecată on, mâini off. Copiază în .env (gitignored).
# Secrets stay here, never in settings.yaml.

ANTHROPIC_API_KEY=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=
AUTH_TRUST_HOST=true
AUTH_URL=
BACKEND_SHARED_SECRET=

# Required by packages/core Settings — no default. Use your work email.
# Gmail MCP is off in F1; the value is still the Executive identity.
EXEC_EMAIL_ADDRESS=you@company.com
EXEC_DISPLAY_NAME=Executive

# F1 locks
MCP_ENABLED=false
ENABLE_WEB_SEARCH=false
HONCHO_ENABLED=false
OPENROUTER_ENABLED=false
LOCAL_MODELS_ENABLED=false
CLIENT_ROTATION_ENABLED=false
NOTION_SYNC_ENABLED=false
ALERT_REVIEW_ENABLED=false
ALERT_REVIEW_MAX_MOVES_PER_SCAN=0
OE_PUBLIC_DEPLOYMENT=

DEFAULT_MODEL=claude-sonnet-5
DEEP_REASONING_MODEL=claude-opus-5
ROUTING_MODEL=claude-haiku-4-5
ENABLE_CACHING=true

# Do not set Slack / Discord / Telegram / Google Workspace OAuth in F1.
