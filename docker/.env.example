# Copy this file to the repository root before starting the stack:
#   cp docker/.env.example .env

# At least one model provider must be configured. Anthropic is the default.
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-sonnet-5
DEEP_REASONING_MODEL=claude-opus-4-7
ROUTING_MODEL=claude-haiku-4-5-20251001

# Required operator identity and Google OAuth settings.
EXEC_EMAIL_ADDRESS=operator@example.com
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=operator@example.com
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Generate independently with: openssl rand -hex 32
BACKEND_SHARED_SECRET=
BACKEND_ALLOWED_ORIGINS=http://localhost:3000

# GitLab MCP write boundary. Comma-separate full group/project paths. Leave
# empty for read-only GitLab access.
GITLAB_HOST=gitlab.com
GITLAB_WRITE_NAMESPACES=

# Host ports. If UI_PORT changes, update AUTH_URL, BACKEND_ALLOWED_ORIGINS,
# and the Google OAuth redirect URI to use the same port.
UI_PORT=3000
API_PORT=8000

# Optional model-provider alternatives.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
LOCAL_MODELS_ENABLED=false
# From a Linux container, use host.docker.internal rather than localhost.
LOCAL_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_API_KEY=
LOCAL_MODELS=

ENABLE_CACHING=true
USER_TIMEZONE=UTC
